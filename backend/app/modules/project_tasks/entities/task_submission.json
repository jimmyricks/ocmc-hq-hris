{
  "name": "task_submission",
  "label": "Task Submission",
  "module": "project_tasks",
  "table_name": "task_submission",
  "title_field": "id",
  "in_sidebar": true,
  "icon": "send",
  "group": "Projects",
  "fields": [
    {
      "name": "task_assignment_id",
      "label": "Task Assignment",
      "field_type": "link",
      "link_entity": "task_assignment",
      "required": true,
      "in_list_view": true
    },
    {
      "name": "version",
      "label": "Version",
      "field_type": "int",
      "required": true,
      "default": 1,
      "in_list_view": true
    },
    {
      "name": "previous_submission_id",
      "label": "Previous Submission",
      "field_type": "link",
      "link_entity": "task_submission"
    },
    {
      "name": "notes",
      "label": "Notes",
      "field_type": "text"
    },
    {
      "name": "status",
      "label": "Status",
      "field_type": "select",
      "required": true,
      "default": "draft",
      "options": [
        "draft",
        "submitted",
        "under_review",
        "needs_revision",
        "approved",
        "rejected"
      ],
      "in_list_view": true
    },
    {
      "name": "submitted_by",
      "label": "Submitted By",
      "field_type": "link",
      "link_entity": "user",
      "required": true,
      "in_list_view": true
    },
    {
      "name": "submitted_at",
      "label": "Submitted At",
      "field_type": "datetime",
      "required": true
    },
    {
      "name": "external_link",
      "label": "External Link",
      "field_type": "string",
      "required": false,
      "description": "URL to externally hosted deliverable (e.g. Google Drive)"
    }
  ],
  "rbac": {
    "SystemManager": [
      "*"
    ],
    "Administrator": [
      "read",
      "create",
      "update"
    ],
    "ProjectManager": [
      "read",
      "create",
      "update"
    ],
    "User": [
      "read",
      "create",
      "update"
    ]
  }
}
