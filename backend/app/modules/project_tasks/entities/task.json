{
  "name": "task",
  "label": "Task",
  "module": "project_tasks",
  "table_name": "task",
  "title_field": "title",
  "in_sidebar": true,
  "icon": "clipboard-list",
  "group": "Projects",
  "fields": [
    {
      "name": "project_id",
      "label": "Project",
      "field_type": "link",
      "link_entity": "project",
      "required": true,
      "in_list_view": true
    },
    {
      "name": "workspace_id",
      "label": "Workspace",
      "field_type": "link",
      "link_entity": "workspace",
      "required": false,
      "readonly": true,
      "in_list_view": true
    },
    {
      "name": "task_type_id",
      "label": "Task Type",
      "field_type": "link",
      "link_entity": "task_type",
      "required": true,
      "in_list_view": true
    },
    {
      "name": "category_id",
      "label": "Category",
      "field_type": "link",
      "link_entity": "task_category",
      "required": false,
      "in_list_view": true
    },
    {
      "name": "title",
      "label": "Title",
      "field_type": "string",
      "required": true,
      "in_list_view": true
    },
    {
      "name": "description",
      "label": "Description",
      "field_type": "text"
    },
    {
      "name": "priority",
      "label": "Priority",
      "field_type": "select",
      "required": true,
      "default": "medium",
      "options": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "in_list_view": true
    },
    {
      "name": "status",
      "label": "Status",
      "field_type": "select",
      "required": true,
      "default": "pending",
      "options": [
        "draft",
        "pending",
        "in_progress",
        "for_approval",
        "for_review",
        "submitted",
        "needs_revision",
        "approved",
        "done",
        "closed",
        "cancelled"
      ],
      "in_list_view": true
    },
    {
      "name": "due_date",
      "label": "Due Date",
      "field_type": "datetime"
    },
    {
      "name": "artist_portal_kind",
      "label": "Artist Portal Item Type",
      "field_type": "select",
      "required": false,
      "options": ["song", "milestone"]
    },
    {
      "name": "public_summary",
      "label": "Artist-facing Summary",
      "field_type": "text",
      "required": false
    },
    {
      "name": "integration_kind",
      "label": "Bahandi Integration",
      "field_type": "select",
      "required": false,
      "options": ["press_release"]
    }
  ],
  "rbac": {
    "SystemManager": [
      "*"
    ],
    "Administrator": [
      "*"
    ],
    "ProjectManager": [
      "read",
      "create",
      "update"
    ],
    "Employee": [
      "read",
      "create"
    ]
  }
}
